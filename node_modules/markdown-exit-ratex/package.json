{
  "name": "markdown-exit-ratex",
  "version": "0.2.2",
  "description": "A markdown-exit plugin that renders TeX math to server-side SVG with RaTeX.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ratex-render-svg": "./bin/ratex-render-svg.mjs"
  },
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cjs.mjs",
    "test": "npm run build && node test/smoke.mjs && node test/require.cjs",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:e2e:bundled": "npm run build && node test/e2e-bundled.mjs"
  },
  "keywords": [
    "markdown-exit",
    "markdown-it-plugin",
    "ratex",
    "latex",
    "math",
    "svg",
    "ssr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Efterklang/markdown-exit-ratex.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "markdown-exit": ">=1.0.0-beta.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.0",
    "markdown-exit": "^1.0.0-beta.9",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
